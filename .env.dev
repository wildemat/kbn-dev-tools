# ===========================================================================
# kbn-dev environment configuration
#
# The installer creates .env from this template automatically.
# Edit .env to override defaults — it is gitignored and sourced by kbn-dev.
# Only uncomment and change values you want to override.
# ===========================================================================

# ---------------------------------------------------------------------------
# Chrome / Browser
# ---------------------------------------------------------------------------

# Path to Google Chrome executable. Auto-detected if not set
# (checks standard macOS and Linux locations).
# CHROME_BIN="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

# Set to any value to skip Chrome profile setup and browser launch entirely.
# SKIP_BROWSER_LAUNCH=1

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Directory for log files.
# KBN_DEV_LOG_DIR="$HOME/.kbn-dev/logs"

# ---------------------------------------------------------------------------
# Elastic Inference Service (EIS)
# ---------------------------------------------------------------------------

# Elastic inference service URL. Set to "" to disable EIS entirely.
# When enabled, vault access is verified upfront and 'node scripts/eis.js'
# runs after each ES cluster is ready.
# KBN_DEV_INFERENCE_URL="https://inference.eu-west-1.aws.svc.qa.elastic.cloud"

# If set, this API key is used directly and vault is skipped.
# Useful for CI or when vault is unavailable.
# KIBANA_EIS_CCM_API_KEY=""

# ---------------------------------------------------------------------------
# ES Serverless configuration
# ---------------------------------------------------------------------------

# Serverless project type passed to `yarn es serverless --projectType`.
# Valid values: elasticsearch_general_purpose, observability, security
# KBN_DEV_ES_SLS_PROJECT_TYPE="elasticsearch_general_purpose"

# Additional args to pass to `yarn es serverless`. Space-separated.
# Example: KBN_DEV_ES_SLS_EXTRA_ARGS="--tag git-fec36430fba2-x86_64"
# KBN_DEV_ES_SLS_EXTRA_ARGS=""

# ---------------------------------------------------------------------------
# ES Stateful configuration
# ---------------------------------------------------------------------------

# License type for the stateful ES snapshot cluster.
# Valid values: basic, trial
# KBN_DEV_ES_STACK_LICENSE="trial"

# Whether to enable xpack.ml (Machine Learning) on the stateful cluster.
# Disable to reduce memory usage when not working on ML features.
# Set to "true" if you need anomaly detection, data frame analytics,
# trained models, or ML-based alerting rules.
# KBN_DEV_ES_STACK_ML_ENABLED="false"

# Additional args to pass to `yarn es snapshot`. Space-separated.
# Example: KBN_DEV_ES_STACK_EXTRA_ARGS="-E xpack.security.audit.enabled=true"
# KBN_DEV_ES_STACK_EXTRA_ARGS=""
