# kbn-dev environment configuration
# Copy to .env and uncomment any values you want to override.

# Chrome executable path (auto-detected if unset)
# CHROME_BIN="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

# Skip Chrome profile setup and browser launch entirely
# SKIP_BROWSER_LAUNCH=1

# Log file directory
# KBN_DEV_LOG_DIR="$HOME/.kbn-dev/logs"

# Elastic Inference Service URL (set to "" to disable)
# KBN_DEV_INFERENCE_URL="https://inference.eu-west-1.aws.svc.qa.elastic.cloud"

# EIS API key — skips vault lookup when set
# KIBANA_EIS_CCM_API_KEY=""

# Serverless project type passed to `yarn es serverless --projectType`
# KBN_DEV_ES_SLS_PROJECT_TYPE="elasticsearch_general_purpose"

# Extra args passed to `yarn es serverless`
# KBN_DEV_ES_SLS_EXTRA_ARGS=""

# License type for the stateful ES snapshot cluster
# KBN_DEV_ES_STACK_LICENSE="trial"

# Enable xpack.ml on the stateful cluster
# KBN_DEV_ES_STACK_ML_ENABLED="false"

# Extra args passed to `yarn es snapshot`
# KBN_DEV_ES_STACK_EXTRA_ARGS=""

# ===========================================================================
# Details
# ===========================================================================
#
# CHROME_BIN
#   Path to the Google Chrome executable. When unset, kbn-dev checks standard
#   macOS and Linux install locations automatically.
#
# SKIP_BROWSER_LAUNCH
#   Set to any non-empty value to skip Chrome profile setup and skip launching
#   the browser after Kibana starts.
#
# KBN_DEV_LOG_DIR
#   Directory where kbn-dev writes its log files.
#
# KBN_DEV_INFERENCE_URL
#   URL for the Elastic Inference Service. When enabled, vault access is
#   verified upfront and `node scripts/eis.js` runs after each ES cluster is
#   ready. Set to "" to disable EIS entirely.
#
# KIBANA_EIS_CCM_API_KEY
#   When set, this API key is used directly and vault is skipped. Useful for
#   CI environments or when vault is unavailable.
#
# KBN_DEV_ES_SLS_PROJECT_TYPE
#   Serverless project type passed to `yarn es serverless --projectType`.
#   Valid values: elasticsearch_general_purpose, observability, security
#
# KBN_DEV_ES_SLS_EXTRA_ARGS
#   Additional space-separated args forwarded to `yarn es serverless`.
#   Example: --tag git-fec36430fba2-x86_64
#
# KBN_DEV_ES_STACK_LICENSE
#   License type for the stateful ES snapshot cluster.
#   Valid values: basic, trial
#
# KBN_DEV_ES_STACK_ML_ENABLED
#   Set to "true" to enable xpack.ml (Machine Learning) on the stateful
#   cluster. Disable to reduce memory usage when not working on ML features
#   such as anomaly detection, data frame analytics, trained models, or
#   ML-based alerting rules.
#
# KBN_DEV_ES_STACK_EXTRA_ARGS
#   Additional space-separated args forwarded to `yarn es snapshot`.
#   Example: -E xpack.security.audit.enabled=true
